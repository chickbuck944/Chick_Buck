NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=chickbuck
DB_USER=postgres
DB_PASSWORD=change-me
DB_SSL=false
DB_POOL_MAX=10
TRUST_PROXY=false

RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_SECRET=your-razorpay-secret
ADMIN_API_KEY=change-to-a-long-random-staff-secret

# Real customer phone verification via MSG91. Create and approve an OTP
# template in MSG91, then add its template ID and auth key only to .env.
PHONE_OTP_REQUIRED=false
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

ICHEF_API_URL=https://example.ichef-api.com/orders
ICHEF_API_KEY=your-ichef-api-key
ICHEF_API_TIMEOUT_MS=5000

# iChef is local to each shop. Use a restricted SQL login, never sa.
# Keep TEST_MODE=true until barcode mapping, WB-slot reuse and KOT printing are verified.
ICHEF_TEST_MODE=true
# Development-only: permits one supervised localhost order test without Razorpay.
# Never enable this on a public server.
ICHEF_LOCAL_TEST_ORDERS=false
# Development-only: uses dbo.usp_ChickBuck_CreateDeliveryOrder to create a
# real native iChef delivery order. Turn on only for one supervised test.
ICHEF_NATIVE_ORDERS_ENABLED=false
ICHEF_DB_SERVER=
ICHEF_DB_PORT=1433
ICHEF_DB_NAME=ICHEF_LIVE
ICHEF_DB_USER=
ICHEF_DB_PASSWORD=
ICHEF_BRANCH_ID=4
ICHEF_WB_SECTION_ID=4
ICHEF_KITCHEN_ID=1
ICHEF_EMPLOYEE_ID=
ICHEF_DB_CONNECTION_TIMEOUT_MS=5000
ICHEF_DB_REQUEST_TIMEOUT_MS=10000

# Comma-separated browser origins, or * for a non-browser/internal deployment.
CORS_ORIGIN=http://localhost:5500
