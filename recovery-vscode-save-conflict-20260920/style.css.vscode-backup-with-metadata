    border-top: 1px solid rgba(255, 255, 255, 0.12);
    text-align: center;
    font-size: 13px;
}

/* 
   SCROLL ANIMATIONS
*/

.reveal-up,
.reveal-left,
.reveal-right {
    opacity: 0;
    transition:
        opacity 0.85s ease,
        transform 0.85s ease;
}

.reveal-up {
    transform: translateY(45px);
}

.reveal-left {
    transform: translateX(-60px);
}

.reveal-right {
    transform: translateX(60px);
}

.reveal-up.visible,
.reveal-left.visible,
.reveal-right.visible {
    opacity: 1;
    transform: translate(0);
}

.delay-one {
    transition-delay: 0.12s;
}

.delay-two {
    transition-delay: 0.24s;
}

.delay-three {
    transition-delay: 0.36s;
}

.delay-four {
    transition-delay: 0.48s;
}

/* 
   BACK TO TOP
*/

.back-to-top {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 900;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    cursor: pointer;
    color: var(--white);
    background: var(--red);
    box-shadow: 0 14px 32px rgba(196, 0, 0, 0.28);
    font-size: 24px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(18px);
    transition: 0.3s ease;
}

.back-to-top.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.back-to-top:hover {
    transform: translateY(-5px);
    background: var(--red-dark);
}
/* 
   CHICK BUCK MENU PAGE
*/

:root {
    --menu-red: #c40000;
    --menu-dark-red: #5a0000;
    --menu-yellow: #ffd400;
    --menu-white: #ffffff;
    --menu-text: #202020;
    --menu-grey: #6c6c6c;
}


/* GENERAL MENU PAGE */

.menu-page {
    min-height: 100vh;
    overflow: hidden;
    background:
        radial-gradient(
            circle at 10% 5%,
            rgba(255, 212, 0, 0.17),
            transparent 24%
        ),
        radial-gradient(
            circle at 90% 25%,
            rgba(255, 255, 255, 0.08),
            transparent 25%
        ),
        linear-gradient(
            145deg,
            #f20a0a 0%,
            #c40000 52%,
            #7a0000 100%
        );
}

.menu-page .container {
    width: min(1380px, 92%);
    margin-inline: auto;
}


/* 
   MENU HERO
 */

.menu-page-hero {
    position: relative;
    padding: 150px 0 55px;
    text-align: center;
    color: var(--menu-white);
}

.menu-page-hero::before {
    content: "";
    position: absolute;
    top: 80px;
    left: 50%;
    width: 470px;
    height: 470px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    transform: translateX(-50%);
    pointer-events: none;
}

.menu-page-hero::after {
    content: "";
    position: absolute;
    top: 145px;
    left: 50%;
    width: 330px;
    height: 330px;
    border: 1px solid rgba(255, 212, 0, 0.12);
    border-radius: 50%;
    transform: translateX(-50%);
    pointer-events: none;
}

.menu-page-hero .container {
    position: relative;
    z-index: 2;
}

.menu-small-title {
    margin: 0 0 10px;
    color: var(--menu-yellow);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 4px;
    text-transform: uppercase;
}

.menu-page-hero h1 {
    margin: 0;
    color: var(--menu-white);
    font-size: clamp(58px, 8vw, 105px);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -5px;
    text-transform: uppercase;
    text-shadow: 0 12px 35px rgba(61, 7, 8, 0.25);
}

.menu-title-line {
    width: 95px;
    height: 7px;
    margin: 28px auto 0;
    border-radius: 50px;
    background: var(--menu-yellow);
    box-shadow: 0 8px 25px rgba(255, 212, 0, 0.3);
}


/* ==================================================
   CATEGORY FILTERS
================================================== */

.menu-filter-section {
    position: relative;
    z-index: 5;
    padding: 5px 0 50px;
}

.menu-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 11px;
}

.filter-btn {
    min-height: 46px;
    padding: 11px 21px;
    border: 1px solid rgba(255, 255, 255, 0.38);
    border-radius: 50px;
    outline: none;
    color: var(--menu-white);
    background: rgba(255, 255, 255, 0.09);
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    cursor: pointer;
    backdrop-filter: blur(10px);
    transition:
        color 0.3s ease,
        background 0.3s ease,
        border-color 0.3s ease,
        transform 0.3s ease,
        box-shadow 0.3s ease;
}

.filter-btn:hover {
    color: var(--menu-dark-red);
    border-color: var(--menu-yellow);
    background: var(--menu-yellow);
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(58, 7, 8, 0.18);
}

.filter-btn.active {
    color: var(--menu-dark-red);
    border-color: var(--menu-yellow);
    background: var(--menu-yellow);
    box-shadow: 0 10px 24px rgba(58, 7, 8, 0.22);
}

.filter-btn:focus-visible {
    outline: 3px solid rgba(255, 255, 255, 0.8);
    outline-offset: 3px;
}


/* ==================================================
   MENU PRODUCTS
================================================== */

.menu-products-section {
    position: relative;
    z-index: 3;
    padding: 10px 0 110px;
}


/* LAPTOP: 4 BOXES IN ONE ROW */

.menu-products-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    align-items: stretch;
}


/* ==================================================
   MENU CARD
================================================== */

.menu-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 20px;
    background: var(--menu-white);
    box-shadow:
        0 20px 45px rgba(78, 0, 10, 0.18),
        0 3px 10px rgba(78, 0, 10, 0.08);
    transform: translateY(0);
    transition:
        transform 0.35s ease,
        box-shadow 0.35s ease,
        border-color 0.35s ease,
        opacity 0.3s ease;
    /* Avoid painting the many off-screen menu cards until the customer
       scrolls near them. This keeps laptop scrolling responsive. */
    content-visibility: auto;
    contain-intrinsic-size: auto 470px;
}

.menu-card:hover {
    border-color: rgba(255, 212, 0, 0.8);
    transform: translateY(-10px);
    box-shadow:
        0 32px 65px rgba(78, 0, 10, 0.28),
        0 8px 20px rgba(78, 0, 10, 0.12);
}

.menu-card.hide {
    display: none;
}


/* CARD IMAGE */

.menu-card-image {
    position: relative;
    width: 100%;
    height: 245px;
    overflow: hidden;
    background:
        radial-gradient(
            circle at center,
            #fff7de 0%,
            #f5ece4 100%
        );
}

.menu-card-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.12),
        transparent 45%
    );
    pointer-events: none;
}

.menu-card-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
        transform 0.65s ease,
        filter 0.65s ease;
}

.menu-card:hover .menu-card-image img {
    transform: scale(1.08);
    filter: saturate(1.08);
}


/* CARD BADGE */

.menu-badge {
    position: absolute;
    top: 15px;
    left: 15px;
    z-index: 3;
    padding: 8px 13px;
    border-radius: 50px;
    color: var(--menu-dark-red);
    background: var(--menu-yellow);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    box-shadow: 0 8px 18px rgba(55, 0, 7, 0.18);
}


/* CARD CONTENT */

.menu-card-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 205px;
    padding: 21px 20px 22px;
}

.menu-card-content h2 {
    margin: 0 0 10px;
    color: var(--menu-red);
    font-size: 19px;
    font-weight: 800;
    line-height: 1.25;
}

.menu-card-content p {
    display: -webkit-box;
    margin: 0 0 20px;
    overflow: hidden;
    color: var(--menu-grey);
    font-size: 12.5px;
    line-height: 1.7;
    -webkit-box-orient: vertical;
    line-clamp: 3;
}

.menu-price {
    display: block;
    margin-top: auto;
    color: var(--menu-red);
    font-size: 27px;
    font-weight: 900;
    line-height: 1;
}


/* SMALL YELLOW DECORATION */

.menu-card-content::after {
    content: "";
    position: absolute;
    right: -18px;
    bottom: -18px;
    width: 65px;
    height: 65px;
    border-radius: 50%;
    background: rgba(255, 212, 0, 0.14);
    pointer-events: none;
}


/* ==================================================
   CARD ENTRY ANIMATION
================================================== */

.menu-card {
    animation: menuCardAppear 0.55s ease both;
}

.menu-card:nth-child(4n + 2) {
    animation-delay: 0.05s;
}

.menu-card:nth-child(4n + 3) {
    animation-delay: 0.1s;
}

.menu-card:nth-child(4n + 4) {
    animation-delay: 0.15s;
}

@keyframes menuCardAppear {
    from {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}


/* REDUCED MOTION */

@media (prefers-reduced-motion: reduce) {
    .menu-card,
    .menu-card-image img,
    .filter-btn {
        animation: none;
        transition: none;
    }
}/* ==================================================
   PREMIUM ATTRACTIVE ANIMATIONS
================================================== */

/* Floating food image */

.hero-main-image,
.about-story-image-card img {
    animation: floatFood 5s ease-in-out infinite;
}

/* Smaller laptops benefit from lighter hover rendering while preserving the
   same layout and interaction. */
@media (max-width: 1440px) {
    .menu-card:hover {
        box-shadow: 0 22px 45px rgba(78, 0, 10, 0.22);
    }

    .menu-card:hover .menu-card-image img {
        filter: none;
    }
}

