/* 
   SMOOTH RESPONSIVE NAVIGATION
 */

.site-header .glass-nav-links.is-liquid-ready a.active {
    border-color: transparent;
    background: transparent;
    box-shadow: none;
}

@media (min-width: 901px) {
    .site-header .glass-nav-links a {
        transition:
            color 240ms ease,
            text-shadow 240ms ease,
            transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .site-header .glass-nav-links a:hover,
    .site-header .glass-nav-links a:focus-visible {
        transform: translateY(-1px);
    }
}

@media (min-width: 768px) and (max-width: 900px) {
    .site-header .glass-nav-links {
        transform-origin: top center;
        transform: translate3d(0, -14px, 0) scale(0.965);
        transition:
            opacity 320ms ease,
            visibility 320ms ease,
            transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .site-header .glass-nav-links.open {
        transform: translate3d(0, 0, 0) scale(1);
    }

    .site-header .glass-nav-links a {
        opacity: 0;
        transform: translate3d(-12px, -4px, 0);
        transition:
            opacity 220ms ease,
            transform 360ms cubic-bezier(0.22, 1, 0.36, 1),
            background-color 220ms ease,
            border-color 220ms ease;
    }

    .site-header .glass-nav-links.open a {
        opacity: 1;
        transform: translate3d(0, 0, 0);
        transition-delay: calc(var(--nav-item-index, 0) * 45ms + 35ms);
    }
}

@media (max-width: 767px) {
    .mobile-bottom-nav__inner {
        position: relative;
        isolation: isolate;
    }

    .mobile-bottom-nav__indicator {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        z-index: 0;
        pointer-events: none;
        border-radius: 999px;
        background: linear-gradient(135deg, #ffe342 0%, #ffc400 100%);
        box-shadow:
            0 8px 22px rgba(0, 0, 0, 0.22),
            inset 0 1px 0 rgba(255, 255, 255, 0.58);
        transition:
            width 440ms cubic-bezier(0.22, 1, 0.36, 1),
            transform 440ms cubic-bezier(0.22, 1, 0.36, 1);
        will-change: width, transform;
    }

    .mobile-bottom-nav__indicator.no-transition {
        transition: none;
    }

    .mobile-bottom-nav__item {
        z-index: 1;
    }

    .mobile-bottom-nav__item.is-active {
        background: transparent;
        box-shadow: none;
        transform: translateY(-1px);
    }

    .mobile-bottom-nav__item svg,
    .mobile-bottom-nav__label {
        transition:
            transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
            color 220ms ease;
    }

    .mobile-bottom-nav__item.is-active svg {
        transform: translateY(-1px) scale(1.06);
    }
}

@media (prefers-reduced-motion: reduce) {
    .site-header .glass-nav-links,
    .site-header .glass-nav-links a,
    .mobile-bottom-nav__indicator,
    .mobile-bottom-nav__item svg,
    .mobile-bottom-nav__label {
        transition: none !important;
    }
}

