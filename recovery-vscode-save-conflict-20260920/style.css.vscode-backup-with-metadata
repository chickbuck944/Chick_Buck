        letter-spacing: 2px;
    }

    .about-hero-copy h1 {
        font-size: 45px;
        letter-spacing: -2px;
    }

    .about-hero-description {
        font-size: 13px;
        line-height: 1.75;
    }

    .about-hero-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .about-button {
        width: 100%;
    }

    .about-mini-stats {
        gap: 14px;
    }

    .about-mini-stats div {
        padding-right: 14px;
    }

    .about-mini-stats strong {
        font-size: 21px;
    }

    .about-mini-stats span {
        font-size: 7px;
    }

    .about-product-stage {
        min-height: 400px;
    }

    .about-product-glow {
        width: 305px;
        height: 305px;
    }

    .about-hero-product {
        width: min(315px, 90%);
        max-height: 385px;
    }

    .about-product-shadow {
        bottom: 25px;

        width: 205px;
    }

    .about-product-badge {
        right: 0;
        bottom: 62px;

        padding: 8px 11px;

        font-size: 7px;
    }

    .about-steam {
        top: 26px;
        height: 75px;
    }

    .about-statistics {
        padding-bottom: 70px;
    }

    .about-statistics-grid,
    .about-values-grid,
    .outlet-media-grid {
        grid-template-columns: 1fr;
    }

    .about-stat {
        min-height: 190px;
    }

    .about-story-grid {
        gap: 38px;
    }

    .about-story-frame,
    .about-story-frame img {
        min-height: 375px;
    }

    .about-purpose-card {
        min-height: 325px;
        padding: 30px 24px;
    }

    .about-purpose-card h3 {
        font-size: 26px;
    }

    .about-value-card {
        min-height: 280px;
    }

    .outlet-video-trigger {
        height: 280px;
    }

    .about-section-heading {
