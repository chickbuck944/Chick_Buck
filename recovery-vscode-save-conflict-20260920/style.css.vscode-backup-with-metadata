        background 0.35s ease,
        box-shadow 0.35s ease;
}

.about-value-card:hover {
    transform:
        translateY(-9px) scale(1.01);

    border-color:
        rgba(255, 212, 0, 0.65);

    background:
        rgba(255, 255, 255, 0.14);

    box-shadow:
        var(--about-shadow);
}

.about-value-large-number {
    position: absolute;
    top: 10px;
    right: 17px;

    color:
        rgba(255, 255, 255, 0.075);

    font-size: 90px;
    font-weight: 900;
    line-height: 1;
}

.about-value-icon {
    position: relative;
    z-index: 2;

    width: 55px;
    height: 55px;
    margin-bottom: 53px;

    display: grid;
    place-items: center;

    border-radius: 16px;

    color: var(--about-red-dark);
    background: var(--about-yellow);

    font-size: 23px;
    font-weight: 900;

    box-shadow:
        0 12px 25px rgba(78, 0, 10, 0.2);
}

.about-value-card h3 {
    position: relative;
    z-index: 2;

    color: var(--about-white);

    font-size: 22px;
    font-weight: 800;
}

.about-value-card p {
    position: relative;
    z-index: 2;

    margin-top: 12px;

    color: var(--about-text);

    font-size: 13px;
    line-height: 1.75;
}


/* ==================================================
   OUTLET VIDEO CARDS
================================================== */

.about-outlets {
    background:
        radial-gradient(
            circle at center,
            rgba(255, 212, 0, 0.08),
            transparent 50%
        );
}

.outlet-media-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 23px;
}

.outlet-media-card {
    overflow: hidden;

    border:
        1px solid var(--about-border);

    border-radius: 20px;

    background:
        rgba(255, 255, 255, 0.1);

    box-shadow:
        0 20px 45px rgba(72, 0, 10, 0.2);

    transition:
        transform 0.35s ease,
        border-color 0.35s ease,
        box-shadow 0.35s ease;
}

.outlet-media-card:hover {
    transform: translateY(-9px);

    border-color:
        rgba(255, 212, 0, 0.7);

    box-shadow:
        var(--about-shadow);
}

.outlet-video-trigger {
    position: relative;

    width: 100%;
    height: 320px;

    display: block;
    overflow: hidden;

    padding: 0;
    border: 0;
    border-radius: inherit;

    color: inherit;
    background: transparent;

    cursor: pointer;
    text-align: left;
}

.outlet-video-trigger img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    transition:
        transform 0.65s ease,
        filter 0.65s ease;
}

.outlet-media-card:hover img {
    transform: scale(1.075);
    filter: brightness(0.82) saturate(1.08);
}

.outlet-media-overlay {
    position: absolute;
    inset: 0;

    padding: 24px;

    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;

    background:
        linear-gradient(
            to top,
            rgba(67, 0, 9, 0.96),
            rgba(67, 0, 9, 0.08) 63%
        );
}

.outlet-play-button {
    width: 55px;
    height: 55px;

    display: grid;
    place-items: center;

    border:
        1px solid rgba(255, 255, 255, 0.6);

    border-radius: 50%;

    color: var(--about-red-dark);
    background: var(--about-yellow);

    font-size: 17px;

    box-shadow:
        0 14px 30px rgba(75, 0, 10, 0.3);

    transition:
        transform 0.3s ease,
        background 0.3s ease;
}

.outlet-media-card:hover
.outlet-play-button {
    transform: scale(1.11);

    background: var(--about-white);
}

.outlet-media-overlay small {
    color: var(--about-yellow);

    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.6px;
    text-transform: uppercase;
}

.outlet-media-overlay h3 {
    margin-top: 6px;

    color: var(--about-white);

    font-size: 16px;
    font-weight: 800;
    line-height: 1.3;
}


/* ==================================================
   VIDEO MODAL
================================================== */

.outlet-video-modal {
    position: fixed;
    inset: 0;
    z-index: 10000;

    padding: 24px;

    display: grid;
    place-items: center;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
        opacity 0.3s ease,
        visibility 0.3s ease;
}

.outlet-video-modal.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}

.outlet-modal-backdrop {
    position: absolute;
    inset: 0;

    background:
        rgba(43, 0, 6, 0.86);

    backdrop-filter: blur(13px);
    -webkit-backdrop-filter: blur(13px);
}

.outlet-modal-dialog {
    position: relative;
    z-index: 2;

    width: min(920px, 96%);
    max-height: 90vh;

    overflow: hidden;

    border:
        1px solid rgba(255, 255, 255, 0.18);

    border-radius: 21px;

    background: #3c0708;

    box-shadow:
        0 35px 90px rgba(0, 0, 0, 0.52);

    transform:
        translateY(30px) scale(0.96);

    transition:
        transform 0.35s ease;
}

.outlet-video-modal.is-open
.outlet-modal-dialog {
    transform:
        translateY(0) scale(1);
}

.outlet-modal-header {
    min-height: 72px;
    padding: 13px 17px 13px 25px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    border-bottom:
        1px solid rgba(255, 255, 255, 0.13);

    background:
        linear-gradient(
            135deg,
            var(--about-red),
            var(--about-red-dark)
        );
}

.outlet-modal-header h2 {
    color: var(--about-white);

    font-size: 16px;
    font-weight: 800;
}

.outlet-modal-close {
    width: 43px;
    height: 43px;

    display: grid;
    place-items: center;

    border: 0;
    border-radius: 50%;

    color: var(--about-red-dark);
    background: var(--about-yellow);

    font-size: 27px;
    line-height: 1;

    cursor: pointer;
}

.outlet-modal-video-wrap {
    position: relative;

    background: #000000;
}

.outlet-modal-video-wrap video {
    display: block;

    width: 100%;
    max-height: calc(90vh - 72px);

    background: #000000;
}

.outlet-video-status {
    position: absolute;
    inset: 0;

    display: none;
    place-items: center;

    padding: 25px;

    color: var(--about-white);
    background: #3c0708;

    text-align: center;
    font-size: 13px;
}

.outlet-video-status.is-visible {
    display: grid;
}

body.outlet-modal-open {
    overflow: hidden;
}


/* ==================================================
   FINAL CTA
================================================== */

.about-final-cta {
    position: relative;

    padding: 105px 0;

    overflow: hidden;

    text-align: center;

    border-top:
        1px solid rgba(255, 255, 255, 0.09);

    background:
        radial-gradient(
            circle at center,
            rgba(255, 212, 0, 0.18),
            transparent 52%
        ),
        linear-gradient(
            135deg,
            var(--about-red),
            var(--about-red-dark)
        );
}

.about-final-cta-content {
    max-width: 850px;
}

.about-final-cta-content > p {
    color: var(--about-yellow);

    font-size: 11px;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
}

.about-final-cta-content h2 {
    margin-top: 13px;

    color: var(--about-white);

    font-size: clamp(40px, 6vw, 68px);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -3px;
}

.about-final-actions {
    margin-top: 32px;

    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
}


/* ==================================================
   REVEAL ANIMATION
================================================== */

.reveal-item {
    opacity: 0;

    transform: translateY(38px);

    transition:
        opacity 0.8s ease,
        transform 0.8s ease;
}

.reveal-item.is-visible {
    opacity: 1;

    transform: translateY(0);
}


/* ==================================================
   ABOUT KEYFRAMES
================================================== */

@keyframes aboutButtonShine {
    0%,
    55% {
        left: -120%;
    }

    100% {
        left: 160%;
    }
}

@keyframes aboutProductFloat {
    0%,
    100% {
        transform:
            translateY(0)
            rotateX(1deg)
            rotateY(-6deg)
            rotateZ(-1deg);
    }

    50% {
        transform:
            translateY(-17px)
            rotateX(-1deg)
            rotateY(6deg)
            rotateZ(1deg);
    }
}

@keyframes aboutGlowPulse {
    0%,
    100% {
        opacity: 0.7;

        transform:
            translate(-50%, -50%)
            scale(0.94);
    }

    50% {
        opacity: 1;

        transform:
            translate(-50%, -50%)
            scale(1.07);
    }
}

@keyframes aboutShadowMove {
    0%,
    100% {
        opacity: 0.78;

        transform:
            translateX(-50%)
            scale(1);
    }

    50% {
        opacity: 0.45;

        transform:
            translateX(-50%)
            scale(0.83);
    }
}

@keyframes aboutSteamRise {
    0% {
        opacity: 0;

        transform:
            translateY(48px)
            translateX(0)
            scale(0.7);
    }

    35% {
        opacity: 0.54;
    }

    100% {
        opacity: 0;

        transform:
            translateY(-75px)
            translateX(17px)
            scale(1.4);
    }
}


/* ==================================================
   ABOUT RESPONSIVE — TABLET
================================================== */

