    }

    .about-final-cta {
        padding: 78px 0;
    }

    .about-final-cta-content h2 {
        font-size: 38px;
        letter-spacing: -2px;
    }
}


/* ==================================================
   REDUCED MOTION
================================================== */

@media (prefers-reduced-motion: reduce) {

    .about-hero-product,
    .about-product-glow,
    .about-product-shadow,
    .about-steam,
    .about-button::before {
        animation: none;
    }

    .reveal-item {
        opacity: 1;
        transform: none;
        transition: none;
    }
}

/* ==================================================
   HOME PAGE ASSET + SCOPE FIXES
================================================== */

body.home-page {
    background: var(--white);
}

.home-page .food-image img {
    display: block;
    object-fit: cover;
    object-position: center;
    padding: 0;
}

.home-page .feature-card .food-image img {
    padding: 0;
}

.home-page .hero-bucket-stage {
    min-height: 580px;
}

/* ==================================================
   UNIFIED ANIMATED WEBSITE BACKGROUND
   HOME + MENU + ABOUT
================================================== */

body.site-theme {
    position: relative;
    min-height: 100vh;
    isolation: isolate;
    overflow-x: hidden;
    color: #ffffff;

    background:
        radial-gradient(
            circle at 13% 12%,
            rgba(255, 212, 0, 0.20),
            transparent 28%
        ),
        radial-gradient(
            circle at 87% 72%,
            rgba(255, 124, 40, 0.22),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            #430809 0%,
            #7a0000 38%,
            #c40000 68%,
            #f20a0a 100%
        );

    background-size: 190% 190%;
    background-attachment: fixed;

    animation:
        siteThemeGradient 15s ease-in-out infinite;
}

body.site-theme::before,
body.site-theme::after {
    content: "";
    position: fixed;
    z-index: -1;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(45px);
}

body.site-theme::before {
    top: 10%;
    left: -130px;
    width: 370px;
    height: 370px;
    background: rgba(255, 212, 0, 0.15);
    animation: siteThemeLightOne 10s ease-in-out infinite;
}

body.site-theme::after {
    right: -150px;
    bottom: 8%;
    width: 430px;
    height: 430px;
    background: rgba(255, 255, 255, 0.08);
    animation: siteThemeLightTwo 12s ease-in-out infinite;
}

body.site-theme > header,
body.site-theme > main,
body.site-theme > footer,
body.site-theme > .back-to-top,
body.site-theme > .outlet-video-modal {
    z-index: 1;
}

body.site-theme .hero-section,
body.site-theme .menu-page,
body.site-theme .about-page,
body.site-theme .specials-section,
body.site-theme .experience-section,
body.site-theme .home-cta,
body.site-theme .about-story,
body.site-theme .about-purpose,
body.site-theme .about-values,
body.site-theme .about-outlets,
body.site-theme .about-final-cta {
    background: transparent !important;
}

body.site-theme .specials-section,
body.site-theme .experience-section,
body.site-theme .about-story,
body.site-theme .about-values {
    border-top: 1px solid rgba(255, 255, 255, 0.10);
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);

    background:
        linear-gradient(
            135deg,
            rgba(75, 0, 11, 0.20),
            rgba(255, 255, 255, 0.045)
        ) !important;

    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
}

body.site-theme .section-heading h2,
body.site-theme .experience-content h2,
body.site-theme .experience-content h3,
body.site-theme .quality-item h3 {
    color: #ffffff;
}

body.site-theme .section-label,
body.site-theme .section-heading h2 span,
body.site-theme .experience-content h2 span {
    color: #ffd400;
}

body.site-theme .section-heading > p:last-child,
body.site-theme .experience-content > p:not(.section-label),
body.site-theme .quality-item p {
    color: rgba(255, 255, 255, 0.78);
}

body.site-theme .food-card,
body.site-theme .menu-card {
    color: #151c2a;
    background: #ffffff;
}

body.site-theme .site-footer {
    background:
        linear-gradient(
            145deg,
            rgba(12, 13, 18, 0.98),
            rgba(24, 8, 13, 0.98)
        );
}

@keyframes siteThemeGradient {
    0%,
    100% {
        background-position: 0% 50%;
    }

    50% {
        background-position: 100% 50%;
    }
}

@keyframes siteThemeLightOne {
    0%,
    100% {
        transform: translate(0, 0) scale(1);
    }

    50% {
        transform: translate(150px, 90px) scale(1.18);
    }
}

@keyframes siteThemeLightTwo {
    0%,
    100% {
        transform: translate(0, 0) scale(1);
    }

    50% {
        transform: translate(-130px, -90px) scale(1.15);
    }
}


/* ==================================================
   NEW HOME VIDEO HERO
================================================== */

.home-page.site-theme .hero-section.video-hero {
    position: relative;
    min-height: 100svh;
    padding: 145px 0 88px;
    display: flex;
    align-items: center;
    overflow: hidden;
}

.home-page.site-theme .video-hero .hero-grid {
    position: relative;
    z-index: 4;
    grid-template-columns: minmax(0, 1.04fr) minmax(340px, 0.76fr);
    gap: clamp(45px, 6vw, 90px);
}

.hero-background-animation,
.hero-grid-pattern {
    position: absolute;
    inset: 0;
    pointer-events: none;
}

.hero-background-animation {
    z-index: 0;
    overflow: hidden;
}

.hero-grid-pattern {
    opacity: 0.32;

    background-image:
        linear-gradient(
            rgba(255, 255, 255, 0.055) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.055) 1px,
            transparent 1px
        );

    background-size: 58px 58px;

    mask-image:
        linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0.95),
            transparent 92%
        );

    animation:
        heroGridDrift 18s linear infinite;
}

.hero-orb {
