.home-page.site-theme .video-hero .hero-title {
    max-width: 760px;
}

.home-page.site-theme .video-hero .hero-description {
    max-width: 640px;
}

.hero-video-shell {
    --video-rotate-x: 0deg;
    --video-rotate-y: 0deg;

    position: relative;
    width: min(430px, 100%);
    margin-left: auto;
    perspective: 1200px;
}

.hero-video-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: -1;
    width: 112%;
    height: 88%;
    border-radius: 45%;
    background:
        radial-gradient(
            circle,
            rgba(255, 212, 0, 0.42),
            rgba(255, 76, 34, 0.18) 48%,
            transparent 72%
        );
    filter: blur(32px);
    transform: translate(-50%, -50%);
    animation: heroVideoGlow 4.6s ease-in-out infinite;
}

.hero-video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 13;
    overflow: hidden;

    border: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: 34px;

    background: #250607;

    box-shadow:
        0 42px 85px rgba(70, 0, 9, 0.42),
        inset 0 1px 0 rgba(255, 255, 255, 0.20);

    transform:
        rotateX(var(--video-rotate-x))
        rotateY(var(--video-rotate-y));

    transform-style: preserve-3d;

    transition:
        transform 0.18s ease-out,
        box-shadow 0.35s ease;
}

.hero-video-frame::before {
