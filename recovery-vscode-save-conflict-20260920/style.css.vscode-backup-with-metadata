    background: #120c0e;
}

@media (max-width: 900px) {
    .site-header .glass-nav-actions {
        display: none;
    }
}

@media (max-width: 767px) {
    .mobile-bottom-nav__inner {
        grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .mobile-bottom-nav__theme {
        border: 0;
        background: transparent;
        cursor: pointer;
        font: inherit;
    }

    .mobile-bottom-nav__theme-icon {
        flex: 0 0 23px;
        width: 23px;
        height: 23px;
        display: grid;
        place-items: center;
        line-height: 1;
        transition: transform 220ms ease, color 220ms ease;
    }

    .mobile-theme-icon {
        width: 21px;
        height: 21px;
    }

    .mobile-theme-icon-sun {
        display: none;
    }

    html[data-chickbuck-dark] .mobile-theme-icon-moon {
        display: none;
    }

    html[data-chickbuck-dark] .mobile-theme-icon-sun {
        display: block;
    }

    .mobile-bottom-nav__theme:active .mobile-bottom-nav__theme-icon {
        transform: scale(0.92) rotate(-8deg);
    }
}

@media (prefers-reduced-motion: reduce) {
    .site-header .glass-theme-toggle,
    .glass-theme-icon,
    .mobile-bottom-nav__theme-icon {
        transition: none !important;
    }
}

/* TIRUR HERO — DESKTOP ALIGNMENT */
@media (min-width: 901px) {
    /* . */
    .site-header.glass-header {
        width: min(1320px, calc(100% - 80px));
    }

    .home-page.site-theme .video-hero .hero-slide > .container {
        width: min(1440px, calc(100% - 80px));
    }

    .home-page.site-theme .video-hero .signature-hero-slide .hero-grid {
        grid-template-columns: minmax(0, 1.08fr) minmax(430px, 0.78fr);
        gap: clamp(54px, 6vw, 96px);
    }

    .home-page.site-theme .video-hero .tirur-seasonal-grid {
        grid-template-columns: minmax(0, 1fr) minmax(390px, 0.82fr);
        align-items: center;
        gap: clamp(48px, 6vw, 88px);
    }

    .home-page.site-theme .video-hero .tirur-seasonal-copy {
        align-self: center;
        padding-block: 18px;
    }

    .home-page.site-theme .video-hero .tirur-seasonal-visual {
        min-height: clamp(540px, calc(100svh - 214px), 610px);
        justify-self: end;
        width: min(100%, 480px);
    }

    .home-page.site-theme .video-hero .tirur-seasonal-visual::before,
    .home-page.site-theme .video-hero .tirur-sunburst {
        right: 50%;
        bottom: 50%;
        transform: translate(50%, 50%);
    }

    .home-page.site-theme .video-hero .tirur-seasonal-slide .seasonal-food-card {
        width: min(400px, 82%);
    }

    .home-page.site-theme .video-hero .tirur-location {
        top: 8%;
        right: 3%;
    }
}
