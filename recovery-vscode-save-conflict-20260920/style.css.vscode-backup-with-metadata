    }

    .first-shop-photo-copy strong {
        font-size: 18px;
    }

    .first-shop-gallery-hint {
        justify-content: flex-start;
    }

    .first-shop-lightbox {
        padding: 12px;
    }

    .first-shop-lightbox-dialog {
        grid-template-columns: 1fr 1fr;
