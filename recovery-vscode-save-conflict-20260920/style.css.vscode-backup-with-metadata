/* ==================================================
   ABOUT — OUR FIRST SHOP PHOTO CORNER
================================================== */

.first-shop-gallery {
    position: relative;
    overflow: hidden;
    color: #fff;
    background:
        radial-gradient(circle at 12% 14%, rgba(255, 212, 0, 0.17), transparent 28%),
        radial-gradient(circle at 88% 82%, rgba(255, 104, 51, 0.2), transparent 31%),
        linear-gradient(138deg, #4e0000 0%, #8d0000 43%, #c40000 100%);
    isolation: auto;
}

.first-shop-gallery::before,
.first-shop-gallery::after {
    position: absolute;
    z-index: 1;
    border: 1px solid rgba(255, 212, 0, 0.16);
    border-radius: 50%;
    content: "";
    pointer-events: none;
}

.first-shop-gallery::before {
    top: -210px;
    right: -130px;
    width: 480px;
    height: 480px;
}

.first-shop-gallery::after {
    bottom: -300px;
    left: -190px;
    width: 620px;
    height: 620px;
}

.first-shop-gallery-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.75fr);
    gap: clamp(30px, 7vw, 100px);
    align-items: end;
    margin-bottom: clamp(34px, 5vw, 64px);
}

.first-shop-gallery-kicker {
    display: inline-flex;
    gap: 9px;
    align-items: center;
    margin: 0 0 16px;
    color: var(--yellow);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.8px;
    text-transform: uppercase;
}

.first-shop-gallery-kicker span {
    font-size: 8px;
    filter: drop-shadow(0 0 8px rgba(255, 212, 0, 0.75));
}

.first-shop-gallery-heading h2 {
    max-width: 760px;
    margin: 0;
    color: #fff;
    font-size: clamp(42px, 6vw, 82px);
    line-height: 0.93;
    letter-spacing: -3px;
}

.first-shop-gallery-heading h2 span {
    display: block;
    color: var(--yellow);
}

.first-shop-gallery-intro {
    max-width: 490px;
    margin: 0 0 5px;
    padding-left: 22px;
    border-left: 2px solid rgba(255, 212, 0, 0.68);
    color: rgba(255, 255, 255, 0.82);
    font-size: 16px;
    line-height: 1.8;
}

.first-shop-photo-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-flow: dense;
    grid-auto-rows: clamp(190px, 17vw, 245px);
    gap: clamp(12px, 1.45vw, 20px);
}

.first-shop-photo {
    position: relative;
    grid-column: span 4;
    min-width: 0;
    overflow: hidden;
    padding: 0;
    border: 1px solid rgba(255, 212, 0, 0.34);
    border-radius: clamp(18px, 2vw, 28px);
    color: #fff;
    background: #420000;
    box-shadow: 0 18px 42px rgba(45, 0, 0, 0.28);
    cursor: zoom-in;
    font: inherit;
    text-align: left;
    transition:
        opacity 0.7s ease,
        transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1),
        border-color 0.3s ease,
        box-shadow 0.3s ease;
}

.first-shop-photo--hero {
    grid-column: span 7;
    grid-row: span 2;
}

.first-shop-photo--hero + .first-shop-photo,
.first-shop-photo--hero + .first-shop-photo + .first-shop-photo {
    grid-column: span 5;
}

.first-shop-photo--panorama {
    grid-column: span 12;
    min-height: 275px;
}

.first-shop-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.4s ease;
}

.first-shop-photo--panorama img {
    object-position: center 45%;
}

.first-shop-photo-shade {
    position: absolute;
    inset: 0;
    background:
        linear-gradient(180deg, rgba(41, 0, 0, 0.02) 28%, rgba(41, 0, 0, 0.84) 100%),
        linear-gradient(90deg, rgba(41, 0, 0, 0.24), transparent 58%);
    transition: background-color 0.35s ease;
}

.first-shop-photo-copy {
    position: absolute;
    right: clamp(18px, 2vw, 28px);
    bottom: clamp(18px, 2vw, 28px);
    left: clamp(18px, 2vw, 28px);
    display: grid;
    gap: 5px;
    padding-right: 48px;
}

.first-shop-photo-copy small {
    color: var(--yellow);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1.45px;
    text-transform: uppercase;
}

.first-shop-photo-copy strong {
    max-width: 530px;
    color: #fff;
    font-size: clamp(16px, 1.65vw, 24px);
    line-height: 1.15;
}

.first-shop-photo-open {
    position: absolute;
    right: clamp(15px, 1.7vw, 24px);
    bottom: clamp(15px, 1.7vw, 24px);
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.58);
    border-radius: 50%;
    color: #650000;
    background: var(--yellow);
    font-size: 18px;
    font-weight: 900;
    box-shadow: 0 7px 20px rgba(0, 0, 0, 0.2);
    transition: transform 0.3s ease, background-color 0.3s ease;
}

.first-shop-photo:hover {
    z-index: 2;
    border-color: rgba(255, 212, 0, 0.82);
    box-shadow: 0 26px 54px rgba(42, 0, 0, 0.43);
    transform: translateY(-6px);
}

.first-shop-photo:hover img {
    filter: saturate(1.06) contrast(1.03);
    transform: scale(1.045);
}

.first-shop-photo:hover .first-shop-photo-open {
    color: var(--yellow);
    background: var(--red);
    transform: rotate(45deg);
}

.first-shop-photo:focus-visible {
    z-index: 3;
    border-color: #fff;
    outline: 4px solid var(--yellow);
    outline-offset: 4px;
}

.first-shop-gallery-hint {
    display: flex;
    gap: 9px;
    align-items: center;
    justify-content: flex-end;
    margin: 22px 3px 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.35px;
}

.first-shop-gallery-hint span {
    color: var(--yellow);
    font-size: 17px;
}

/* Photo viewer */

body.first-shop-lightbox-open {
    overflow: hidden;
}

.first-shop-lightbox {
    position: fixed;
    z-index: 10050;
    inset: 0;
    display: grid;
    visibility: hidden;
    place-items: center;
    padding: clamp(14px, 3vw, 42px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s ease;
}

.first-shop-lightbox.is-open {
    visibility: visible !important;
    opacity: 1;
    pointer-events: auto;
}

.first-shop-lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(24, 0, 0, 0.94);
    backdrop-filter: blur(14px);
}

.first-shop-lightbox-dialog {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr) 58px;
    align-items: center;
    width: min(1240px, 100%);
    max-height: calc(100vh - clamp(28px, 6vw, 84px));
    transform: translateY(16px) scale(0.985);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.first-shop-lightbox.is-open .first-shop-lightbox-dialog {
    transform: translateY(0) scale(1);
}

.first-shop-lightbox figure {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    min-width: 0;
    max-height: calc(100vh - clamp(28px, 6vw, 84px));
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 212, 0, 0.46);
    border-radius: clamp(18px, 2.2vw, 32px);
    background: #260000;
    box-shadow: 0 35px 90px rgba(0, 0, 0, 0.58);
}

.first-shop-lightbox figure img {
    width: 100%;
    max-height: calc(100vh - 160px);
    object-fit: contain;
    background: #180000;
}

.first-shop-lightbox figcaption {
    display: flex;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
    min-height: 70px;
    padding: 17px clamp(18px, 2.4vw, 34px);
    color: #fff;
    background: linear-gradient(90deg, #670000, #a60000);
}

.first-shop-lightbox figcaption span {
    font-size: 14px;
    font-weight: 650;
    line-height: 1.5;
}

.first-shop-lightbox figcaption small {
    flex: 0 0 auto;
    color: var(--yellow);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1px;
}

.first-shop-lightbox-close,
.first-shop-lightbox-nav {
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.52);
    border-radius: 50%;
    color: #650000;
    background: var(--yellow);
    cursor: pointer;
    font: inherit;
    font-weight: 900;
    transition: color 0.25s ease, background-color 0.25s ease, transform 0.25s ease;
}

.first-shop-lightbox-close {
    position: absolute;
    z-index: 3;
    top: -17px;
    right: 41px;
    width: 48px;
    height: 48px;
    font-size: 29px;
    line-height: 1;
}

.first-shop-lightbox-nav {
    position: relative;
    z-index: 2;
    width: 46px;
    height: 46px;
    margin: 6px;
    font-size: 22px;
}

.first-shop-lightbox-close:hover,
.first-shop-lightbox-nav:hover {
    color: var(--yellow);
    background: var(--red);
    transform: scale(1.07);
}

.first-shop-lightbox-close:focus-visible,
.first-shop-lightbox-nav:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 4px;
}

@media (max-width: 900px) {
    .first-shop-gallery-heading {
        grid-template-columns: 1fr;
        gap: 24px;
    }

    .first-shop-gallery-intro {
        max-width: 680px;
