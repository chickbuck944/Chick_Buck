        repeating-radial-gradient(circle at 83% 38%, transparent 0 31px, rgba(255, 244, 218, 0.24) 32px 33px),
        linear-gradient(100deg, transparent 0 55%, rgba(255, 255, 255, 0.12) 55% 56%, transparent 56%);
