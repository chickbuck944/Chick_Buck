    transform: rotate(90deg) scale(0.35);
}

html[data-chickbuck-dark] .glass-theme-icon-moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
}

html[data-chickbuck-dark] body.site-theme {
    background:
        radial-gradient(circle at 15% 12%, rgba(255, 200, 0, 0.1), transparent 28%),
        radial-gradient(circle at 85% 72%, rgba(210, 25, 40, 0.16), transparent 31%),
        linear-gradient(135deg, #090506 0%, #16070a 42%, #2c070d 72%, #420810 100%);
    background-size: 100% 100%;
    background-attachment: scroll;
    animation: none !important;
}

html[data-chickbuck-dark] body.site-theme::before,
html[data-chickbuck-dark] body.site-theme::after {
    display: none;
}

html[data-chickbuck-dark] .site-header .glass-navbar {
    border-color: rgba(255, 255, 255, 0.18);
    background:
        linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.025)),
        rgba(12, 9, 11, 0.74);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.24),
        inset 0 -1px 0 rgba(255, 255, 255, 0.04),
        0 14px 34px rgba(0, 0, 0, 0.36);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
}

html[data-chickbuck-dark] .site-header .glass-nav-links,
html[data-chickbuck-dark] .site-header .glass-theme-toggle,
html[data-chickbuck-dark] .site-header .glass-visit-button {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
}

html[data-chickbuck-dark] .site-header .glass-navbar::after,
html[data-chickbuck-dark] .site-header .glass-visit-button::before,
html[data-chickbuck-dark] body.site-theme :is(
    .hero-orb,
    .hero-particles,
    .reviews-glow,
    .home-gallery-glow
) {
    display: none !important;
}

html[data-chickbuck-dark] body.home-page .specials-section,
html[data-chickbuck-dark] body.home-page .experience-section,
html[data-chickbuck-dark] body.site-theme.home-page .specials-section,
html[data-chickbuck-dark] body.site-theme.home-page .experience-section {
    color: #f8f3f4 !important;
    background: #120a0c !important;
}

html[data-chickbuck-dark] body.home-page .specials-section :is(h2, h3),
html[data-chickbuck-dark] body.home-page .experience-section :is(h2, h3),
html[data-chickbuck-dark] body.site-theme.home-page .specials-section :is(h2, h3),
html[data-chickbuck-dark] body.site-theme.home-page .experience-section :is(h2, h3) {
    color: #ffffff !important;
}

html[data-chickbuck-dark] body.home-page .specials-section :is(.section-label, h2 span),
html[data-chickbuck-dark] body.home-page .experience-section :is(.section-label, h2 span) {
    color: #ffd400 !important;
}

html[data-chickbuck-dark] body.home-page .specials-section p,
html[data-chickbuck-dark] body.home-page .experience-section p {
    color: rgba(255, 255, 255, 0.7) !important;
}

html[data-chickbuck-dark] body.site-theme :is(
    .food-card,
    .menu-card,
    .review-card,
    .faq-item,
    .about-purpose-card,
    .about-value-card,
    .contact-form-card,
    .contact-info-card,
    .contact-region-card,
    .outlet-location-card
) {
    color: #f8f3f4 !important;
    border-color: rgba(255, 255, 255, 0.13) !important;
    background: linear-gradient(145deg, #24171a, #160f11) !important;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.22) !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
}

html[data-chickbuck-dark] body.site-theme :is(
    .food-card,
    .menu-card,
    .review-card,
    .faq-item,
    .about-purpose-card,
    .about-value-card,
    .contact-form-card,
    .contact-info-card,
    .contact-region-card,
    .outlet-location-card
) :is(h2, h3, h4, strong) {
