    color: #2a1500;
    background: var(--yellow);
}

:where(h1, h2, h3) {
    text-wrap: balance;
}

:where(p, li) {
    text-wrap: pretty;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input,
textarea {
