        grid-template-columns: 1fr;
    }

    .about-values-grid,
    .outlet-media-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }
}


/* ==================================================
   ABOUT RESPONSIVE — PHONE
================================================== */

@media (max-width: 720px) {

    .about-section {
        padding: 75px 0;
    }

    .about-hero {
        min-height: auto;
        padding: 125px 0 60px;
    }

    .about-hero-grid {
