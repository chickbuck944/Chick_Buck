    .about-hero-grid,
    .about-story-grid {
        grid-template-columns: 1fr;
    }

    .about-hero-copy {
        max-width: 760px;
        margin-inline: auto;

        text-align: center;
    }

    .about-hero-actions,
    .about-mini-stats {
