================================================== */

.mobile-bottom-nav {
    display: none;
}

@media (max-width: 767px) {
    body.has-mobile-bottom-nav {
        padding-bottom: calc(100px + env(safe-area-inset-bottom));
    }

    body.has-mobile-bottom-nav .site-header.glass-header {
        display: none !important;
    }

    .mobile-bottom-nav {
        position: fixed;
        right: 12px;
        bottom: max(10px, env(safe-area-inset-bottom));
        left: 12px;
        z-index: 7000;
        display: block;
        width: min(430px, calc(100% - 24px));
        margin-inline: auto;
        padding: 7px;
        border: 1px solid rgba(255, 221, 75, 0.34);
        border-radius: 999px;
        background:
            linear-gradient(135deg, rgba(73, 7, 12, 0.92), rgba(163, 5, 15, 0.88)),
