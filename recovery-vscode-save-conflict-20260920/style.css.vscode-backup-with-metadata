    border-radius: 25px;
    background: linear-gradient(145deg, rgba(255,255,255,0.34), rgba(255,255,255,0.10));
    box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.80),
        inset 0 -1px 0 rgba(255,255,255,0.09),
        0 10px 28px rgba(66,0,10,0.23);
    backdrop-filter: blur(17px);
    -webkit-backdrop-filter: blur(17px);
    font-size: 13px;
    font-weight: 750;
    white-space: nowrap;
    transition: transform 0.30s ease, background 0.30s ease, box-shadow 0.30s ease;
}

.site-header .glass-visit-button::before {
    content: "";
    position: absolute;
    top: 0;
    left: -120%;
    width: 55%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.42), transparent);
    transform: skewX(-24deg);
    animation: liquidVisitShine 4.5s ease-in-out infinite;
}

.site-header .glass-visit-button::after {
    content: "→";
    position: relative;
    z-index: 1;
    flex: 0 0 30px;
    width: 30px;
    height: 30px;
    margin-right: -7px;
    display: grid;
    place-items: center;
    color: #fff;
    border: 1px solid rgba(255,255,255,0.36);
    border-radius: 50%;
    background: linear-gradient(145deg, rgba(255,255,255,0.20), rgba(255,255,255,0.05));
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.40);
    transition: transform 0.30s ease;
}

@keyframes liquidVisitShine {
    0%, 48% { left: -120%; }
    78%, 100% { left: 160%; }
}

.site-header .glass-visit-button:hover {
    color: #fff;
    background: linear-gradient(145deg, rgba(255,255,255,0.43), rgba(255,255,255,0.13));
