/* 
   RESET
*/

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

html.loader-active,
body.loader-active {
    height: 100%;
    overflow: hidden !important;
    overscroll-behavior: none;
}

body {
    font-family: "Poppins", sans-serif;
    color: var(--dark);
    background: var(--white);
    overflow-x: hidden;
}

body.menu-open {
    overflow: hidden;
}

img {
    display: block;
    height: auto;
    max-width: 100%;
}

