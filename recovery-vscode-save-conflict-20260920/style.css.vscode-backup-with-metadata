}

/* Central capsule and sliding liquid indicator */
.site-header .glass-nav-links {
    position: relative;
    z-index: 3;
    isolation: isolate;
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 4px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.20);
    border-radius: 21px;
    background: linear-gradient(135deg, rgba(71,0,11,0.25), rgba(255,255,255,0.07));
    box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.22),
        0 11px 27px rgba(45,0,8,0.16);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
}

.site-header .glass-nav-links .nav-liquid-indicator {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    pointer-events: none;
    border: 1px solid rgba(255,255,255,0.50);
    border-radius: 21px;
    background: linear-gradient(145deg, rgba(255,255,255,0.34), rgba(255,255,255,0.11));
    box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.78),
        inset 0 -1px 0 rgba(255,255,255,0.09),
        0 8px 22px rgba(66,0,11,0.22),
        0 0 18px rgba(255,255,255,0.10);
    transition:
        transform 0.48s cubic-bezier(0.22, 1, 0.36, 1),
        width 0.48s cubic-bezier(0.22, 1, 0.36, 1),
        height 0.48s cubic-bezier(0.22, 1, 0.36, 1),
        opacity 0.25s ease;
    will-change: transform, width, height;
}

.site-header .glass-nav-links .nav-liquid-indicator.no-transition {
    transition: none;
}

.site-header .glass-nav-links .nav-liquid-indicator::after {
    content: "";
    position: absolute;
    inset: 2px 8px auto;
    height: 40%;
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(255,255,255,0.38), transparent);
    opacity: 0.55;
}

.site-header .glass-nav-links a {
    position: relative;
    z-index: 1;
    min-width: 74px;
    min-height: 40px;
    padding: 8px 15px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.82);
    background: transparent;
    border: 0;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 650;
    white-space: nowrap;
    transform: none;
    transition: color 0.28s ease, text-shadow 0.28s ease;
}

.site-header .glass-nav-links a::after {
    display: none;
}

.site-header .glass-nav-links a:hover,
.site-header .glass-nav-links a:focus-visible,
.site-header .glass-nav-links a.active {
    color: #fff;
    background: transparent;
    transform: none;
    text-shadow: 0 1px 12px rgba(255,255,255,0.22);
}

.site-header .glass-nav-links:not(.is-liquid-ready) a.active {
    border: 1px solid rgba(255,255,255,0.44);
    background: linear-gradient(145deg, rgba(255,255,255,0.30), rgba(255,255,255,0.10));
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.68), 0 8px 20px rgba(65,0,10,0.20);
}

