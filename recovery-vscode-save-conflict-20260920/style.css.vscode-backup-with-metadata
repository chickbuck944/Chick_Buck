/* ==================================================
   HOME PAGE SCROLL STORY
================================================== */

.home-page .home-scroll-card {
    transform-origin: center bottom;
    transform-style: preserve-3d;
}

.home-page .home-scroll-card:not(.visible) {
    opacity: 0;
    filter: blur(5px);
    transform:
        perspective(900px)
        translateY(72px)
        rotateX(7deg)
        scale(0.96);
}

.home-page .home-scroll-card.visible {
    opacity: 1;
    filter: blur(0);
    transform:
        perspective(900px)
        translateY(0)
        rotateX(0)
        scale(1);
    transition:
        opacity 0.8s ease,
        transform 0.9s cubic-bezier(0.22, 1, 0.36, 1),
        filter 0.65s ease,
        box-shadow 0.35s ease;
}

.home-page .home-scroll-item:not(.visible) {
    opacity: 0;
    transform: translate3d(38px, 28px, 0);
}

.home-page .home-scroll-item.visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    transition:
        opacity 0.7s ease,
        transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
}

.home-page .home-scroll-visual {
    clip-path: inset(0 24% 0 0 round 54px);
    transition:
        opacity 0.85s ease,
        transform 0.9s cubic-bezier(0.22, 1, 0.36, 1),
        clip-path 1.1s cubic-bezier(0.22, 1, 0.36, 1);
}

.home-page .home-scroll-visual.visible {
    clip-path: inset(0 0 0 0 round 54px);
}

.home-page .home-scroll-pop:not(.visible) {
    opacity: 0;
    transform: translateY(45px) scale(0.92);
}

.home-page .home-scroll-pop.visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    transition:
        opacity 0.8s ease,
        transform 0.95s cubic-bezier(0.22, 1, 0.36, 1);
}

@media (hover: hover) {
    .home-page .home-scroll-card.visible:hover {
        transform: translateY(-10px) scale(1.02);
    }
}

@media (prefers-reduced-motion: reduce) {
    .home-page .home-scroll-card,
    .home-page .home-scroll-item,
    .home-page .home-scroll-visual,
    .home-page .home-scroll-pop {
        opacity: 1 !important;
        filter: none !important;
        clip-path: none !important;
        transform: none !important;
        transition: none !important;
    }
}


