/* VIDEO LOADER */

.page-loader {
    position: fixed;
    inset: 0;
    z-index: 99999;
    width: 100vw;
    max-width: 100%;
    height: 100dvh;
    overflow: hidden;
    background: #000;
    opacity: 1;
    visibility: visible;
    transition: opacity 0.35s ease, visibility 0.35s ease;
}

.page-loader.hide {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
}

.loader-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transition: opacity 0.28s ease;
}

.page-loader.is-video-ready .loader-video {
    opacity: 1;
}

.loader-fallback {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 24px;
    background: #080808;
    transition: opacity 0.28s ease;
}

.page-loader.is-video-ready .loader-fallback {
    opacity: 0;
    pointer-events: none;
}

.loader-fallback img {
    width: clamp(104px, 14vw, 168px);
    height: auto;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.4));
}

.loader-fallback span {
    width: 42px;
    height: 4px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.22);
}

.loader-fallback span::after {
    display: block;
    width: 50%;
    height: 100%;
    border-radius: inherit;
    background: #f20a0a;
    content: "";
    animation: loader-progress 1s ease-in-out infinite alternate;
}

@keyframes loader-progress {
    from { transform: translateX(-100%); }
    to { transform: translateX(200%); }
}

.skip-loader {
    position: absolute;
    right: 28px;
    bottom: 28px;
    z-index: 2;
    padding: 10px 22px;
    border: 1px solid rgba(255, 255, 255, 0.65);
    border-radius: 999px;
    color: #fff;
    background: rgba(0, 0, 0, 0.38);
    font-family: "Poppins", sans-serif;
    font-weight: 700;
    cursor: pointer;
    backdrop-filter: blur(8px);
}

.skip-loader:hover {
    background: #f20a0a;
}

@media (max-width: 767px) {
    .page-loader {
        background: #080808;
    }

    .loader-video {
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        /* Offset the crop slightly right to centre the mobile animation. */
        object-position: 42% center;
        transform: none;
    }
}

@media (max-width: 600px) {
    .skip-loader {
        right: 16px;
        bottom: 18px;
    }
}
