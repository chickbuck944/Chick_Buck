/* ==================================================
   TIRUR OPENING ANNOUNCEMENT
================================================== */

.tirur-seasonal-slide {
    --tirur-red: #f3131d;
    --tirur-ink: #090909;
}

.tirur-seasonal-slide .onam-seasonal-wash {
    inset: -160px -8vw -130px;
    background:
        radial-gradient(circle at 78% 48%, rgba(222, 11, 20, 0.26), transparent 30%),
        radial-gradient(circle at 13% 82%, rgba(239, 17, 27, 0.14), transparent 28%),
        linear-gradient(118deg, #050505 0%, #101010 52%, #090909 100%);
}

.tirur-seasonal-slide .onam-seasonal-wash::before {
    opacity: 0.34;
    background:
        repeating-linear-gradient(130deg, transparent 0 38px, rgba(255, 255, 255, 0.035) 39px 40px),
        linear-gradient(90deg, rgba(237, 13, 23, 0.18), transparent 24% 78%, rgba(237, 13, 23, 0.13));
    mask-image: none;
}

.tirur-seasonal-grid {
    grid-template-columns: minmax(0, 1.02fr) minmax(355px, 0.76fr);
}

.tirur-seasonal-slide .seasonal-kicker,
.tirur-seasonal-slide .seasonal-card-brand {
    border-color: rgba(255, 255, 255, 0.32);
    background: rgba(15, 15, 15, 0.72);
}

.tirur-seasonal-slide .seasonal-label,
.tirur-seasonal-slide .seasonal-date-row span,
.tirur-seasonal-slide .seasonal-food-card figcaption small {
    color: #ff2932;
}

.tirur-seasonal-title {
    font-style: italic;
    letter-spacing: -6px;
}

.tirur-seasonal-title span {
    color: #fff;
    font-size: 0.72em;
    transform: rotate(-3deg);
    transform-origin: left center;
}

.tirur-seasonal-title strong {
    color: var(--tirur-red);
    text-shadow: 0 15px 42px rgba(235, 10, 21, 0.28);
    transform: rotate(-3deg);
    transform-origin: left center;
}

.tirur-seasonal-title em {
    margin-top: 24px;
    padding: 0;
    border: 0;
    border-radius: 0;
    color: #fff;
    background: transparent;
    font-family: cursive;
    font-size: clamp(28px, 3vw, 42px);
    font-weight: 700;
    transform: rotate(-7deg);
}

.tirur-seasonal-slide .button-yellow {
    color: #fff;
    background: var(--tirur-red);
    box-shadow: 0 12px 28px rgba(231, 10, 21, 0.28);
}

.tirur-seasonal-slide .button-yellow:hover,
.tirur-seasonal-slide .button-yellow:focus-visible {
    background: #ff333b;
}

.tirur-seasonal-visual {
    min-height: 600px;
}

.tirur-seasonal-visual::before {
    content: "";
    position: absolute;
    right: 1%;
    bottom: 1%;
    width: min(460px, 96%);
    aspect-ratio: 1;
    border: 18px solid rgba(243, 19, 29, 0.9);
    border-radius: 50%;
    box-shadow: 0 0 0 15px rgba(255, 255, 255, 0.06), 0 0 95px rgba(243, 19, 29, 0.26);
}

.tirur-sunburst {
    position: absolute;
    right: -1%;
    bottom: 5%;
    width: min(480px, 100%);
    aspect-ratio: 1;
    border-radius: 50%;
    background: repeating-conic-gradient(from -12deg, rgba(243, 19, 29, 0.7) 0 5deg, transparent 5deg 18deg);
    mask-image: radial-gradient(circle, transparent 0 40%, #000 41% 63%, transparent 64%);
    opacity: 0.45;
}

.tirur-location {
    position: absolute;
    z-index: 6;
    top: 9%;
    right: 3%;
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    border: 2px solid #fff;
    border-radius: 50%;
    color: #fff;
    background: var(--tirur-red);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    font-size: 38px;
    line-height: 1;
}

.tirur-seasonal-slide .seasonal-food-card {
    width: min(400px, 86%);
    border-color: rgba(255, 255, 255, 0.94);
    border-radius: 32px;
    transform: rotate(1deg);
}

.tirur-seasonal-slide .seasonal-food-card::after {
    background:
        linear-gradient(to top, rgba(4, 4, 4, 0.96), transparent 43%),
        linear-gradient(145deg, rgba(243, 19, 29, 0.2), transparent 36%);
}

.tirur-seasonal-slide .seasonal-food-image {
    object-position: center 48%;
}

@media (max-width: 768px) {
    .tirur-seasonal-grid {
        grid-template-columns: 1fr;
    }

    .tirur-seasonal-title span,
    .tirur-seasonal-title strong {
        transform-origin: center;
    }

    .tirur-seasonal-visual {
        min-height: 460px;
    }

    .tirur-seasonal-visual::before {
        width: min(360px, 86vw);
        border-width: 12px;
    }

    .tirur-location {
        top: 4%;
        right: 8%;
        width: 52px;
        height: 52px;
        font-size: 30px;
    }
}

@keyframes floatFood {
    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-12px);
    }
}


/* Shining buttons */

.button,
.glass-visit-button {
    position: relative;
    overflow: hidden;
}

.button::before,
.glass-visit-button::before {
    content: "";
    position: absolute;
    top: 0;
    left: -120%;
    width: 60%;
    height: 100%;

    background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.45),
        transparent
    );

    transform: skewX(-25deg);
    animation: buttonShine 3s infinite;
}

@keyframes buttonShine {
    100% {
        left: 160%;
    }
}


/* Card hover effect */

.food-card,
.menu-card,
.about-love-card,
.about-stat-card,
.mission-vision-card,
.outlet-card {
    transition:
        transform 0.35s ease,
        box-shadow 0.35s ease;
}

.food-card:hover,
.menu-card:hover,
.about-love-card:hover,
.about-stat-card:hover,
.mission-vision-card:hover,
.outlet-card:hover {
    transform: translateY(-10px) scale(1.02);
}


/* Scroll reveal */

.reveal-up,
.reveal-left,
.reveal-right {
    opacity: 0;
    transition:
        opacity 0.8s ease,
        transform 0.8s ease;
}

.reveal-up {
    transform: translateY(45px);
}

.reveal-left {
    transform: translateX(-55px);
}

.reveal-right {
    transform: translateX(55px);
}

.reveal-up.visible,
.reveal-left.visible,
.reveal-right.visible {
    opacity: 1;
    transform: translate(0);
}


/* Reduce animation for users who prefer less motion */

@media (prefers-reduced-motion: reduce) {
    .hero-main-image,
    .about-story-image-card img,
    .button::before,
    .glass-visit-button::before {
        animation: none;
    }
}


/* ==================================================
   3D-STYLE HERO BUCKET
================================================== */

.hero-bucket-stage {
    position: relative;
    width: 100%;
    min-height: 580px;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1100px;
    isolation: isolate;
}

.bucket-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 0;
    width: 430px;
    height: 430px;
    border-radius: 50%;
    background: radial-gradient(
        circle,
        rgba(255, 212, 0, 0.68) 0%,
        rgba(255, 130, 20, 0.24) 42%,
        transparent 72%
    );
    filter: blur(12px);
    transform: translate(-50%, -50%);
    animation: bucketGlow 3.5s ease-in-out infinite;
}

.hero-bucket-image {
    position: relative;
    z-index: 3;
    width: min(460px, 90%);
    max-height: 570px;
    object-fit: contain;
    filter:
        drop-shadow(0 30px 25px rgba(71, 0, 9, 0.42))
        saturate(1.08);
    transform-origin: center bottom;
    transform-style: preserve-3d;
    animation: bucket3DMove 6s ease-in-out infinite;
}

.bucket-shadow {
    position: absolute;
    left: 50%;
    bottom: 42px;
    z-index: -1;
    width: 280px;
    height: 42px;
    border-radius: 50%;
    background: rgba(72, 0, 8, 0.42);
    filter: blur(15px);
    transform: translateX(-50%);
    animation: bucketShadow 6s ease-in-out infinite;
}

.steam {
    position: absolute;
    top: 52px;
    z-index: 5;
    width: 24px;
    height: 105px;
    border-radius: 50%;
    background: linear-gradient(
        to top,
        transparent,
        rgba(255, 255, 255, 0.5),
        transparent
    );
    filter: blur(9px);
    opacity: 0;
    pointer-events: none;
    animation: steamRise 3.5s ease-in-out infinite;
}

.steam-one { left: 43%; }
.steam-two { left: 52%; animation-delay: 1.1s; }
.steam-three { left: 60%; animation-delay: 2.1s; }

@keyframes bucket3DMove {
    0%, 100% {
        transform: translateY(0) rotateX(1deg) rotateY(-7deg) rotateZ(-1deg);
    }
    50% {
        transform: translateY(-18px) rotateX(-1deg) rotateY(7deg) rotateZ(1deg);
    }
}

@keyframes bucketGlow {
    0%, 100% {
        opacity: 0.65;
        transform: translate(-50%, -50%) scale(0.94);
    }
    50% {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1.08);
    }
}

@keyframes bucketShadow {
    0%, 100% {
        opacity: 0.8;
        transform: translateX(-50%) scale(1);
    }
    50% {
        opacity: 0.48;
        transform: translateX(-50%) scale(0.84);
    }
}

@keyframes steamRise {
    0% {
        opacity: 0;
        transform: translateY(50px) translateX(0) scale(0.7);
    }
    35% { opacity: 0.55; }
    100% {
        opacity: 0;
        transform: translateY(-75px) translateX(18px) scale(1.4);
    }
}

@media (max-width: 700px) {
    .hero-bucket-stage { min-height: 430px; }
    .hero-bucket-image {
        width: min(330px, 90%);
        max-height: 410px;
    }
    .bucket-glow {
        width: 310px;
        height: 310px;
    }
    .bucket-shadow {
        bottom: 28px;
        width: 210px;
    }
    .steam {
        top: 30px;
        height: 80px;
    }
}

@media (prefers-reduced-motion: reduce) {
    .hero-bucket-image,
    .bucket-glow,
    .bucket-shadow,
    .steam {
        animation: none;
    }
