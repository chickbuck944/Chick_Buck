}

html[data-chickbuck-dark] body.site-theme :is(
    .food-card,
    .menu-card,
    .review-card,
    .faq-item,
    .about-purpose-card,
    .about-value-card,
    .contact-form-card,
    .contact-info-card,
    .contact-region-card,
    .outlet-location-card
) p {
    color: rgba(255, 255, 255, 0.68) !important;
}

