                if (cart.has(id)) cart.get(id).quantity += 1;
                else cart.set(id, { id, name: item.name, price: getNumericPrice(item.price), quantity: 1 });
                cartMessageElement.textContent = "";
                renderCart();
            });

        });

        cartItemsElement.addEventListener("click", (event) => {
