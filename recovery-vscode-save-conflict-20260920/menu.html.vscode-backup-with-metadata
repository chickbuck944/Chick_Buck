        const reviewProductTotal = document.getElementById("reviewProductTotal");
        const reviewTotal = document.getElementById("reviewTotal");
        const reviewDeliveryFee = document.getElementById("reviewDeliveryFee");
        const reviewPackingFee = document.getElementById("reviewPackingFee");
        const reviewDeliveryFeeRow = document.getElementById("reviewDeliveryFeeRow");
        const reviewPackingFeeRow = document.getElementById("reviewPackingFeeRow");
