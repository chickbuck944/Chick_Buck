        const deliveryLocationStatus = document.getElementById("deliveryLocationStatus");
        const useMyLocationButton = document.getElementById("useMyLocation");
        const deliveryAddressInput = document.getElementById("deliveryAddress");
        const deliveryPrivacyConsent = document.getElementById("deliveryPrivacyConsent");
        const fillAddressFromGps = async ({ latitude, longitude }) => {
            // GPS gives coordinates, so reverse geocoding turns them into a
            // useful starting address. A customer must still confirm house/flat details.
            if (deliveryAddressInput.value.trim()) return;
            try {
                const params = new URLSearchParams({
                    format: "jsonv2",
                    lat: latitude,
                    lon: longitude,
                    zoom: "18",
                    addressdetails: "1",
                    "accept-language": navigator.language || "en"
                });
                const response = await fetch(`https://nominatim.openstreetmap.org/reverse?${params}`);
                if (!response.ok) return;
                const locationAddress = await response.json();
                if (!locationAddress.display_name) return;
                deliveryAddressInput.value = locationAddress.display_name;
                deliveryLocationStatus.textContent += " Address filled from GPS — please add or correct your house/flat number.";
            } catch {
                // Location itself remains valid even when an address lookup is unavailable.
            }
        };
        const requestDeliveryLocation = () => {
            // Browsers protect location data: a customer must approve the
            // browser prompt, and non-localhost deployments need HTTPS.
            if (!window.isSecureContext && location.hostname !== "localhost") {
                deliveryLocationStatus.textContent = "Location requires the secure HTTPS website. This local Wi-Fi test link cannot access phone GPS.";
                return;
            }
            deliveryQuote = undefined;
            if (!navigator.geolocation) {
                deliveryLocationStatus.textContent = "Location is unavailable in this browser.";
                return;
            }
            deliveryLocationStatus.textContent = "Checking your location…";
            navigator.geolocation.getCurrentPosition(async ({ coords }) => {
                deliveryLocation = { latitude: coords.latitude, longitude: coords.longitude };
                fillAddressFromGps(deliveryLocation);
                try {
                    const response = await fetch(`${window.CHICK_BUCK_API_URL}/api/delivery/quote`, {
                        method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(deliveryLocation)
                    });
                    const responseBody = await response.text();
                    let quote;
                    try { quote = JSON.parse(responseBody); } catch { throw new Error(`The delivery service returned HTTP ${response.status}.`); }
                    if (!response.ok) throw new Error(quote.error || `The delivery service returned HTTP ${response.status}.`);
                    if (!quote.available) {
                        deliveryLocation = undefined;
                        deliveryLocationStatus.textContent = "Sorry, Chick Buck doesn't deliver to your location yet.";
                        return;
                    }
                    deliveryQuote = quote;
                    deliveryLocationStatus.textContent = `${quote.outlet.name} will deliver to you (${quote.distanceKm} km away).`;
                } catch (error) {
                    deliveryLocation = undefined;
                    deliveryQuote = undefined;
                    deliveryLocationStatus.textContent = error.message === "Failed to fetch"
                        ? "Cannot reach the Chick Buck delivery service. Keep the backend running and make sure this phone uses the same Wi-Fi."
                        : error.message;
                }
            }, () => {
                deliveryLocationStatus.textContent = "Location permission was not granted. Please allow it to check delivery availability.";
            }, { enableHighAccuracy: true, timeout: 10000, maximumAge: 300000 });
        };
        useMyLocationButton.addEventListener("click", requestDeliveryLocation);
        // Ask automatically for delivery visitors. The browser still controls
        // the permission prompt; table QR orders never request GPS.
        if (!isTableOrder) requestDeliveryLocation();

        const openReview = () => {
            const items = [...cart.values()];
            const tableNumber = tableNumberInput.value.trim();
            const totalAmount = items.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            if (isTableOrder && !tableNumber) {
                cartMessageElement.textContent = "Enter your table number before continuing.";
                closeCart();
                tableOrderPanel.scrollIntoView({ behavior: "smooth", block: "center" });
                tableNumberInput.focus();
                return;
            }
            if (!items.length) {
                cartMessageElement.textContent = "Add at least one menu item first.";
                return;
            }
            const deliveryDetails = isTableOrder ? undefined : {
                customerName: document.getElementById("deliveryName").value.trim(),
                phone: document.getElementById("deliveryPhone").value.trim(),
                address: document.getElementById("deliveryAddress").value.trim(),
                ...deliveryLocation
