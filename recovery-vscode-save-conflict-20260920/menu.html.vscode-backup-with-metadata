            if (!isTableOrder && (!deliveryDetails.customerName || !deliveryDetails.phone || !deliveryDetails.address || !deliveryLocation || !deliveryPrivacyConsent.checked)) {
                cartMessageElement.textContent = "Complete delivery details, location and privacy consent before continuing.";
                const firstMissingField = !deliveryDetails.customerName
                    ? document.getElementById("deliveryName")
                    : !deliveryDetails.phone
                        ? document.getElementById("deliveryPhone")
                        : !deliveryDetails.address
                            ? document.getElementById("deliveryAddress")
                            : !deliveryLocation
                                ? useMyLocationButton
                                : deliveryPrivacyConsent;
                scrollToDeliveryDetails(firstMissingField);
                return;
            }

            const bill = getBill(totalAmount);
            reviewItems.innerHTML = items.map((item) => `<div><span>${item.quantity} × ${item.name}</span><strong>₹${(item.price * item.quantity).toFixed(2)}</strong></div>`).join("");
            reviewProductTotal.textContent = `₹${bill.productTotal.toFixed(2)}`;
            reviewDeliveryFee.textContent = "FREE";
            reviewPackingFee.textContent = "FREE";
            reviewTotal.textContent = `₹${bill.totalAmount.toFixed(2)}`;
            reviewDeliveryFeeRow.hidden = isTableOrder;
            reviewPackingFeeRow.hidden = isTableOrder;
            reviewOrderType.textContent = isTableOrder ? `Table order · Table ${tableNumber}` : "Delivery order";
            reviewDelivery.hidden = isTableOrder;
            if (!isTableOrder) {
                reviewCustomerName.textContent = deliveryDetails.customerName;
                reviewAddress.textContent = deliveryDetails.address;
                reviewPhone.textContent = deliveryDetails.phone;
            }
            orderReviewModal.classList.add("is-open");
            orderReviewModal.setAttribute("aria-hidden", "false");
        };
        document.getElementById("checkoutButton").addEventListener("click", openReview);
        document.getElementById("closeReview").addEventListener("click", () => { orderReviewModal.classList.remove("is-open"); orderReviewModal.setAttribute("aria-hidden", "true"); });
        document.getElementById("confirmOrderButton").addEventListener("click", async () => {
            const items = [...cart.values()];
            const tableNumber = tableNumberInput.value.trim();
            const totalAmount = items.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            const selectedAddons = [...document.querySelectorAll(".addon-options input:checked")].map((input) => input.value);
            const typedRequest = orderAddons.value.trim();
            const specialRequests = [...selectedAddons, typedRequest].filter(Boolean).join(", ");
            const deliveryDetails = isTableOrder ? undefined : {
                customerName: document.getElementById("deliveryName").value.trim(),
                phone: document.getElementById("deliveryPhone").value.trim(),
                address: document.getElementById("deliveryAddress").value.trim(),
                specialRequests,
                ...deliveryLocation
            };

            const checkoutButton = document.getElementById("confirmOrderButton");
            checkoutButton.disabled = true;
            checkoutButton.textContent = "Creating order…";
            cartMessageElement.textContent = "";
            try {
                const response = await fetch(`${window.CHICK_BUCK_API_URL}/api/orders`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        orderType: isTableOrder ? "TABLE" : "DELIVERY",
                        ...(isTableOrder ? { tableNumber } : { deliveryDetails }),
                        items: items.map(({ id, quantity, price }) => ({ id, quantity, price })),
                        totalAmount: Number(totalAmount.toFixed(2))
                    })
                });
                const result = await response.json();
                if (!response.ok) throw new Error(result.error || "Unable to create the order.");
                cartMessageElement.textContent = result.ichefOrder
                    ? `Order ${result.transactionId} sent to iChef using ${result.wbSlot}. KOT ${result.kotNumber}: check the kitchen and iChef screen.`
                    : result.testOrder
                        ? `Test order sent to iChef using ${result.wbSlot}. Check the kitchen and iChef screen.`
                        : `Order ${result.orderId} created. Razorpay checkout will open after payment keys are configured.`;
            } catch (error) {
                cartMessageElement.textContent = error.message === "Failed to fetch"
                    ? "The ordering API is unavailable. Confirm it is running on port 3000."
                    : error.message;
            } finally {
                checkoutButton.disabled = false;
                checkoutButton.textContent = "Place order";
            }
        });
        renderCart();

