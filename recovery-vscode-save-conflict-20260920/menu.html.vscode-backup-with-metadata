        let deliveryLocation;
        let deliveryQuote;
        const getBill = (productTotal) => {
            if (isTableOrder) return { productTotal, deliveryFee: 0, packingFee: 0, totalAmount: productTotal };
            return { productTotal, deliveryFee: 0, packingFee: 0, totalAmount: productTotal };
        };
        const scrollToDeliveryDetails = (fieldToFocus) => {
            closeCart();
            deliveryOrderPanel.scrollIntoView({ behavior: "smooth", block: "center" });
            window.setTimeout(() => fieldToFocus?.focus(), 450);
        };
        tableOrderPanel.hidden = !isTableOrder;
        deliveryOrderPanel.hidden = isTableOrder;
        if (isTableOrder) tableNumberInput.value = tableFromQr.trim().slice(0, 50);

        const getNumericPrice = (price) => Number(String(price).replace(/[^0-9.]/g, ""));
        const closeCart = () => {
            cartPanel.classList.remove("is-open");
            cartToggle.setAttribute("aria-expanded", "false");
        };
        const openCart = () => {
            cartPanel.classList.add("is-open");
            cartToggle.setAttribute("aria-expanded", "true");
        };

        const renderCart = () => {
            const entries = [...cart.values()];
            const count = entries.reduce((sum, item) => sum + item.quantity, 0);
            const total = entries.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            cartCountElement.textContent = count;
            cartTotalElement.textContent = `₹${total.toFixed(2)}`;
            cartButtonTotal.textContent = `₹${total.toFixed(0)}`;
            cartToggle.hidden = count === 0;
            document.body.classList.toggle("has-active-cart", count > 0);
            if (count === 0) closeCart();
            cartItemsElement.innerHTML = entries.length
                ? entries.map((item) => `
                    <div class="cart-item">
                        <div><strong>${item.name}</strong><span>₹${item.price.toFixed(2)} each</span></div>
                        <div class="cart-quantity">
                            <button aria-label="Remove one ${item.name}" data-cart-action="decrease" data-id="${item.id}" type="button">−</button>
                            <span>${item.quantity}</span>
                            <button aria-label="Add one ${item.name}" data-cart-action="increase" data-id="${item.id}" type="button">+</button>
                        </div>
                    </div>`).join("")
                : "<p class=\"cart-empty\">Your cart is empty. Add a menu item to begin.</p>";
        };

        const changeQuantity = (id, change) => {
            const item = cart.get(id);
            if (!item) return;
            item.quantity += change;
            if (item.quantity <= 0) cart.delete(id);
            renderCart();
        };

        menuItems.forEach((item, index) => {

            const card = document.createElement("article");

            card.className = "menu-card reveal-item";

            card.dataset.category = item.category;


            const imageFile =
                menuImages[item.name] ??
                normalizedMenuImages.get(
                    item.name.trim().toLocaleLowerCase()
